// ---------------------------------------------------------------
// BUSINESS-HUB COMPUTERS (RC: 3001886)
// Database schema - PostgreSQL + Prisma
// ---------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================== ENUMS ===========================

enum AdminRole {
  SUPER_ADMIN
  ADMIN
}

enum AdminStatus {
  ACTIVE
  SUSPENDED
}

enum PermissionKey {
  PRODUCT_MANAGEMENT
  CATEGORY_MANAGEMENT
  INVENTORY_MANAGEMENT
  ORDER_MANAGEMENT
  CUSTOMER_MANAGEMENT
  PAYMENT_MANAGEMENT
  MARKETING_MANAGEMENT
  CONTENT_MANAGEMENT
  REPORT_MANAGEMENT
  TASK_MANAGEMENT
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
  COMPLETED
  OVERDUE
  REJECTED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProductCondition {
  NEW
  REFURBISHED
  UK_USED
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  READY_FOR_DELIVERY
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  PAYSTACK
  FLUTTERWAVE
  BANK_TRANSFER
  PAY_ON_DELIVERY
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum DiscountScope {
  PRODUCT
  CATEGORY
  ORDER
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InventoryAction {
  STOCK_IN
  SALE
  RETURN
  ADJUSTMENT
  DAMAGE
}

enum NotificationType {
  NEW_ORDER
  NEW_CUSTOMER
  LOW_STOCK
  OUT_OF_STOCK
  NEW_REVIEW
  TASK_ASSIGNED
  TASK_DUE_SOON
  TASK_OVERDUE
  PAYMENT_CONFIRMED
  ORDER_STATUS_CHANGE
}

// ==================== ADMINS AND ACCESS ======================

model Admin {
  id                String        @id @default(cuid())
  fullName          String
  email             String        @unique
  phone             String?
  passwordHash      String
  role              AdminRole     @default(ADMIN)
  status            AdminStatus   @default(ACTIVE)
  mustChangePassword Boolean      @default(true)
  avatarUrl         String?
  lastLoginAt       DateTime?
  createdById       String?
  createdBy         Admin?        @relation("AdminCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAdmins     Admin[]       @relation("AdminCreator")
  permissions       AdminPermission[]
  assignedTasks     AdminTask[]   @relation("TaskAssignee")
  createdTasks      AdminTask[]   @relation("TaskAssigner")
  auditLogs         AuditLog[]
  notifications     Notification[]
  orderNotes        OrderNote[]
  inventoryEntries  InventoryTransaction[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([role, status])
}

model AdminPermission {
  id        String        @id @default(cuid())
  adminId   String
  admin     Admin         @relation(fields: [adminId], references: [id], onDelete: Cascade)
  key       PermissionKey
  canView   Boolean       @default(true)
  canCreate Boolean       @default(false)
  canEdit   Boolean       @default(false)
  canDelete Boolean       @default(false)
  grantedAt DateTime      @default(now())

  @@unique([adminId, key])
  @@index([key])
}

model AdminTask {
  id              String       @id @default(cuid())
  title           String
  description     String
  assigneeId      String
  assignee        Admin        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  assignedById    String
  assignedBy      Admin        @relation("TaskAssigner", fields: [assignedById], references: [id], onDelete: Cascade)
  priority        TaskPriority @default(MEDIUM)
  status          TaskStatus   @default(PENDING)
  startDate       DateTime     @default(now())
  deadline        DateTime
  completedAt     DateTime?
  attachmentUrl   String?
  adminComment    String?
  superAdminComment String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([assigneeId, status])
  @@index([deadline])
}

// ==================== CATALOGUE ==============================

model Category {
  id            String     @id @default(cuid())
  name          String
  slug          String     @unique
  description   String?
  imageUrl      String?
  iconName      String?
  parentId      String?
  parent        Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children      Category[] @relation("CategoryTree")
  products      Product[]
  discounts     Discount[]
  isPopular     Boolean    @default(false)
  isVisible     Boolean    @default(true)
  sortOrder     Int        @default(0)
  metaTitle     String?
  metaDescription String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([parentId, isVisible])
}

model Product {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  sku             String           @unique
  brand           String
  modelNumber     String?
  shortDescription String?
  description     String
  specifications  Json?
  warrantyInfo    String?
  price           Decimal          @db.Decimal(12, 2)
  previousPrice   Decimal?         @db.Decimal(12, 2)
  costPrice       Decimal?         @db.Decimal(12, 2)
  condition       ProductCondition @default(NEW)
  status          ProductStatus    @default(PUBLISHED)
  isFeatured      Boolean          @default(false)
  isBestSeller    Boolean          @default(false)
  isNewArrival    Boolean          @default(false)
  isOnSale        Boolean          @default(false)
  isDemo          Boolean          @default(false)
  viewCount       Int              @default(0)
  soldCount       Int              @default(0)
  ratingAverage   Float            @default(0)
  ratingCount     Int              @default(0)
  tags            String[]
  metaTitle       String?
  metaDescription String?
  categoryId      String
  category        Category         @relation(fields: [categoryId], references: [id])
  images          ProductImage[]
  variants        ProductVariant[]
  inventory       Inventory?
  cartItems       CartItem[]
  orderItems      OrderItem[]
  reviews         Review[]
  wishlistItems   WishlistItem[]
  discounts       Discount[]
  archivedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([categoryId, status])
  @@index([brand])
  @@index([isFeatured, isBestSeller, isNewArrival])
  @@index([price])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  isPrimary Boolean @default(false)
  sortOrder Int     @default(0)

  @@index([productId])
}

model ProductVariant {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name          String
  value         String
  sku           String   @unique
  priceModifier Decimal  @default(0) @db.Decimal(12, 2)
  stockQuantity Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([productId])
}

// ==================== INVENTORY ==============================

model Inventory {
  id             String                 @id @default(cuid())
  productId      String                 @unique
  product        Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockQuantity  Int                    @default(0)
  minStockLevel  Int                    @default(5)
  totalReceived  Int                    @default(0)
  totalSold      Int                    @default(0)
  stockStatus    StockStatus            @default(OUT_OF_STOCK)
  lastRestockedAt DateTime?
  transactions   InventoryTransaction[]
  updatedAt      DateTime               @updatedAt

  @@index([stockStatus])
}

model InventoryTransaction {
  id           String          @id @default(cuid())
  inventoryId  String
  inventory    Inventory       @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  action       InventoryAction
  quantity     Int
  balanceAfter Int
  reference    String?
  note         String?
  adminId      String?
  admin        Admin?          @relation(fields: [adminId], references: [id], onDelete: SetNull)
  createdAt    DateTime        @default(now())

  @@index([inventoryId, createdAt])
}

// ==================== CUSTOMERS ==============================

model Customer {
  id            String         @id @default(cuid())
  fullName      String
  email         String         @unique
  phone         String
  passwordHash  String
  emailVerified Boolean        @default(false)
  isActive      Boolean        @default(true)
  lastLoginAt   DateTime?
  addresses     Address[]
  carts         Cart[]
  orders        Order[]
  reviews       Review[]
  wishlist      WishlistItem[]
  couponUsages  CouponUsage[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([email])
}

model Address {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label       String?
  recipient   String
  phone       String
  state       String
  city        String
  streetAddress String
  landmark    String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([customerId])
}

model WishlistItem {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
}

// ==================== CART AND ORDERS ========================

model Cart {
  id         String     @id @default(cuid())
  customerId String?
  customer   Customer?  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sessionKey String?    @unique
  items      CartItem[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([customerId])
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  quantity  Int      @default(1)
  unitPrice Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  @@unique([cartId, productId, variantId])
}

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  customerId      String?
  customer        Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  guestName       String?
  guestEmail      String?
  guestPhone      String?
  deliveryState   String
  deliveryCity    String
  deliveryAddress String
  deliveryNote    String?
  subtotal        Decimal       @db.Decimal(12, 2)
  discountTotal   Decimal       @default(0) @db.Decimal(12, 2)
  deliveryFee     Decimal       @default(0) @db.Decimal(12, 2)
  grandTotal      Decimal       @db.Decimal(12, 2)
  couponCode      String?
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(UNPAID)
  items           OrderItem[]
  payments        Payment[]
  notes           OrderNote[]
  cancelledAt     DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([customerId])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  productSku  String
  variantLabel String?
  unitPrice   Decimal @db.Decimal(12, 2)
  quantity    Int
  lineTotal   Decimal @db.Decimal(12, 2)

  @@index([orderId])
}

model OrderNote {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  adminId   String?
  admin     Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)
  body      String
  createdAt DateTime @default(now())

  @@index([orderId])
}

model Payment {
  id            String        @id @default(cuid())
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider      PaymentMethod
  reference     String        @unique
  amount        Decimal       @db.Decimal(12, 2)
  currency      String        @default("NGN")
  status        PaymentStatus @default(PENDING)
  providerPayload Json?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())

  @@index([orderId, status])
}

// ==================== MARKETING ==============================

model Discount {
  id           String        @id @default(cuid())
  name         String
  scope        DiscountScope
  type         DiscountType
  value        Decimal       @db.Decimal(12, 2)
  productId    String?
  product      Product?      @relation(fields: [productId], references: [id], onDelete: Cascade)
  categoryId   String?
  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  startDate    DateTime
  endDate      DateTime
  isFlashSale  Boolean       @default(false)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())

  @@index([isActive, startDate, endDate])
}

model Coupon {
  id            String        @id @default(cuid())
  code          String        @unique
  description   String?
  type          DiscountType
  value         Decimal       @db.Decimal(12, 2)
  minOrderValue Decimal?      @db.Decimal(12, 2)
  usageLimit    Int?
  usageCount    Int           @default(0)
  perUserLimit  Int           @default(1)
  startDate     DateTime
  endDate       DateTime
  isActive      Boolean       @default(true)
  usages        CouponUsage[]
  createdAt     DateTime      @default(now())
}

model CouponUsage {
  id         String   @id @default(cuid())
  couponId   String
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderId    String?
  usedAt     DateTime @default(now())

  @@index([couponId, customerId])
}

model Banner {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  imageUrl  String
  linkUrl   String?
  buttonText String?
  placement String   @default("HOME_HERO")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime @default(now())

  @@index([placement, isActive])
}

model Review {
  id          String       @id @default(cuid())
  productId   String
  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId  String?
  customer    Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  authorName  String
  rating      Int
  title       String?
  body        String
  status      ReviewStatus @default(PENDING)
  isFeatured  Boolean      @default(false)
  createdAt   DateTime     @default(now())

  @@index([productId, status])
}

// ==================== SITE SETTINGS ==========================

model BusinessInformation {
  id                 String   @id @default("singleton")
  companyName        String   @default("BUSINESS-HUB COMPUTERS")
  registrationNumber String   @default("RC: 3001886")
  logoUrl            String?
  description        String?
  website            String?
  businessHours      String?
  updatedAt          DateTime @updatedAt
}

model ContactInformation {
  id             String   @id @default("singleton")
  primaryPhone   String?
  secondaryPhone String?
  whatsappNumber String?
  email          String?
  supportEmail   String?
  address        String?
  openingHours   String?
  mapsLink       String?
  updatedAt      DateTime @updatedAt
}

model SocialLink {
  id        String   @id @default(cuid())
  platform  String   @unique
  url       String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  updatedAt DateTime @updatedAt
}

// ==================== SYSTEM =================================

model Notification {
  id         String           @id @default(cuid())
  adminId    String?
  admin      Admin?           @relation(fields: [adminId], references: [id], onDelete: Cascade)
  type       NotificationType
  title      String
  body       String
  linkUrl    String?
  isRead     Boolean          @default(false)
  createdAt  DateTime         @default(now())

  @@index([adminId, isRead])
}

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String?
  admin      Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)
  actorLabel String
  action     String
  entity     String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([entity, entityId])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model ContactMessage {
  id         String   @id @default(cuid())
  fullName   String
  email      String
  phone      String?
  subject    String?
  message    String
  isRead     Boolean  @default(false)
  respondedAt DateTime?
  createdAt  DateTime @default(now())

  @@index([isRead, createdAt])
}
