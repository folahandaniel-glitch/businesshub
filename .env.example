# ---------------------------------------------------------------
# BUSINESS-HUB COMPUTERS - environment variables
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to version control.
# ---------------------------------------------------------------

# Database (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/businesshub?schema=public"

# Session signing secret. Generate with: openssl rand -base64 48
AUTH_SECRET=""
SESSION_COOKIE_NAME="bhc_session"

# Public site
NEXT_PUBLIC_SITE_URL="https://www.businesshubcomputers.com"
NEXT_PUBLIC_SITE_NAME="BUSINESS-HUB COMPUTERS"

# First-time Super Admin setup. Used once by: npm run setup:admin
# The password must be changed on first login.
SUPER_ADMIN_EMAIL=""
SUPER_ADMIN_PASSWORD=""

# Payments (integration-ready, added in a later stage)
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_PUBLIC_KEY=""

# Object storage for product images
STORAGE_BUCKET=""
STORAGE_REGION=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
